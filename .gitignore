node_modules/
dist/
.turbo/
.next/
.next-*/
# Generated by `next dev` on every start, and it now names whichever distDir started LAST
# (NEXT_DIST_DIR: .next-pooled for AppHost A, .next-zenith for AppHost B). Committing it means a
# diff after every run. The storefront typechecks without it.
apps/storefront/next-env.d.ts
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store

# Identity cache and bootstrap output -- per-machine, written by packages/identity.
.identity/

# Per-instance credential written by the install command (apps/store provision).
.instance/

# Playwright output -- screenshots, traces and the HTML report from `pnpm test:e2e`.
test-results/
playwright-report/

# Written on every `aspire run`: the edge routing table and the address book, both full of
# ports Aspire assigned this run (aspire/AppHostA/traefik/write-dynamic.mjs,
# aspire/scripts/write-stack-manifest.mjs).
aspire/AppHostA/.edge/
.stack/

# Generated by aspire/scripts/run-dedicated.sh: one run directory per concurrently running
# dedicated instance, rewritten from aspire/AppHostB/apphost.cs on every run. The Aspire CLI
# keys a running AppHost on the path of its apphost file, so two at once need two paths.
aspire/AppHostB-*/
